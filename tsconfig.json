{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // `lib/` imports its own modules with explicit .ts extensions so the same
    // files run unmodified under `node --test`. Nothing is emitted from here.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // `.stream` is excluded because MPEG-TS segments are also named `.ts`, and the
  // compiler will happily try to parse a transport stream as TypeScript.
  "exclude": ["node_modules", ".stream", "public"]
}
